{
  "name": "agentic-ready-gh-600",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "dotnet run --project backend/src/Acn.Fde.Practice.AppHost",
    "auth:migrate:local": "wrangler d1 migrations apply acn-fde-auth --local --config wrangler.local.jsonc",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint .",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:backend": "dotnet test backend/Acn.Fde.Practice.slnx",
    "test:qa": "playwright test",
    "typegen:worker": "wrangler types --config=wrangler.local.jsonc --env-file=.dev.vars.example --strict-vars=false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "better-auth": "1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
