{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentic-ready-gh-600",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/health", "/health/*"]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://agentic-ready-gh-600.timothy-barreto.workers.dev",
    "AUTH_TOKEN_ISSUER": "https://agentic-ready-gh-600.timothy-barreto.workers.dev",
    "AUTH_TOKEN_AUDIENCE": "acn-fde-practice-api"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "acn-fde-auth",
      "database_id": "ea5f600d-fc37-4770-a521-87c75de21bf7",
      "migrations_dir": "worker/migrations"
    }
  ],
  "containers": [
    {
      "name": "coreex",
      "class_name": "CoreExContainer",
      "image": "./backend/Dockerfile",
      "image_build_context": ".",
      "max_instances": 1,
      "instance_type": "basic",
      "constraints": {
        "regions": ["ENAM"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COREEX",
        "class_name": "CoreExContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CoreExContainer"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
