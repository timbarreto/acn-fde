{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentic-ready-gh-600-auth-test",
  "main": "worker/test-entry.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:5173",
    "GITHUB_CLIENT_ID": "test-github-client-id",
    "GITHUB_CLIENT_SECRET": "test-github-client-secret",
    "BETTER_AUTH_SECRET": "test-secret-that-is-at-least-thirty-two-characters",
    "AUTH_TOKEN_ISSUER": "http://localhost:5173",
    "AUTH_TOKEN_AUDIENCE": "acn-fde-practice-api",
    "COREEX_API_ORIGIN": "http://127.0.0.1:1"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "acn-fde-auth-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ]
}
